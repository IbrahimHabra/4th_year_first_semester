{
    "openapi": "3.0.0",
    "info": {
        "title": "Maintence API",
        "description": "API Documentation for Maintenance System",
        "contact": {
            "email": "admin@admin.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "User Login",
                "operationId": "a3b306d14572d1f4bd6c064b3233e7b8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@admin.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login Successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "1|AbCdEf123456..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                }
            }
        },
        "/api/dashboard/low-stock-parts": {
            "get": {
                "tags": [
                    "Dashboard"
                ],
                "summary": "Get Low Stock Parts",
                "description": "Returns a list of parts where the current amount is less than or equal to the warning amount.",
                "operationId": "287797a4ce8bb82515551966f533a681",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Compressor Valve"
                                                    },
                                                    "amount": {
                                                        "type": "integer",
                                                        "example": 2
                                                    },
                                                    "warning_amount": {
                                                        "type": "integer",
                                                        "example": 5
                                                    },
                                                    "price_default": {
                                                        "type": "number",
                                                        "format": "float",
                                                        "example": 150
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "apiAuth": []
                    }
                ]
            }
        },
        "/api/dashboard/pending-orders": {
            "get": {
                "tags": [
                    "Dashboard"
                ],
                "summary": "Get Pending Orders",
                "description": "Returns orders that have been added but not yet started. Supports manual chunking via page parameter.",
                "operationId": "59533fee6cc3133efe95f842e5419665",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "The chunk number (1 for first 10, 2 for next 10, etc.)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 15
                                                    },
                                                    "customer_name": {
                                                        "type": "string",
                                                        "example": "Some name"
                                                    },
                                                    "device_model": {
                                                        "type": "string",
                                                        "example": "Samsung S24"
                                                    },
                                                    "assigned_member": {
                                                        "type": "string",
                                                        "example": "another name"
                                                    },
                                                    "add_date": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2025-12-06T10:00:00Z"
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "example": "pending"
                                                    },
                                                    "notes": {
                                                        "type": "string",
                                                        "example": "Screen crack"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "apiAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "apiAuth": {
                "type": "http",
                "description": "Login with email and password to get the authentication token",
                "name": "Token based Based",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Dashboard",
            "description": "Dashboard"
        }
    ]
}